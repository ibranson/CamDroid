<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  Avahi service file for CamDroid. Drop into /etc/avahi/services/ — avahi
  watches that directory and picks up new files without a restart. Tablets
  on the same network discover the Pi by the _camdroid._tcp service type
  via Android's NsdManager (see android/.../data/PiDiscovery.kt).
-->
<service-group>
  <name replace-wildcards="yes">CamDroid on %h</name>
  <service>
    <type>_camdroid._tcp</type>
    <port>8080</port>
    <txt-record>api=v0</txt-record>
    <txt-record>path=/api/v0</txt-record>
  </service>
</service-group>
