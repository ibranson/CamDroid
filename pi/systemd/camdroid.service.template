[Unit]
Description=CamDroid daemon
Documentation=https://github.com/ibranson/CamDroid
After=network-online.target NetworkManager.service
Wants=network-online.target NetworkManager-wait-online.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__HOME__/CamDroid/pi
Environment=PATH=__HOME__/CamDroid/pi/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=__HOME__/CamDroid/pi/.venv/bin/camdroid --bind-interface wlan0 __HOME__/camdroid-storage
Restart=always
RestartSec=2

StandardOutput=journal
StandardError=journal
SyslogIdentifier=camdroid

# Basic hardening — appliance-grade hardening lands in a later milestone.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
