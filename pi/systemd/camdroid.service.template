[Unit]
Description=CamDroid daemon
Documentation=https://github.com/ibranson/CamDroid
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__HOME__/CamDroid/pi
Environment=PATH=__HOME__/CamDroid/pi/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=__HOME__/CamDroid/pi/.venv/bin/camdroid __HOME__/camdroid-storage
Restart=always
RestartSec=2
StartLimitIntervalSec=60
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=camdroid

# Basic hardening — appliance-grade hardening lands in a later milestone.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
